# Robtic — environment. Copy to .env and fill in the Required block; the rest have working defaults.
#
#   cp .env.example .env
#
# On the server this file lives at /home/robtic/robtic-system/.env, is edited by hand, and is shared
# by every container. Recreate containers after editing it — Compose reads it at create time:
#   docker compose -f infra/docker/compose/docker-compose.yml -p robtic-system \
#     --env-file /home/robtic/robtic-system/.env up -d --force-recreate


# ─── Required ────────────────────────────────────────────────────────────────────────────────────

# production reads MainBotToken; anything else reads TestBot. Set it deliberately.
NODE_ENV=production

MONGODB_URI=mongodb://user:password@host:27017/robtic

MainBotToken=
TestBot=


# ─── Bot ─────────────────────────────────────────────────────────────────────────────────────────
#
# Which servers the bot may stay in is NOT an environment variable — it lives in MongoDB and is
# managed from Discord with `!addserver <id>` / `!removeserver <id>`.

# Your Discord user id — bypasses every permission check, so treat it as a credential.
BOT_OWNER_ID=


# ─── Staff points API ────────────────────────────────────────────────────────────────────────────
# Every 100 real messages the bot POSTs one point to <URL>/internal/staff/points. Inside Docker,
# 127.0.0.1 is the container itself — use the host's address, or the service name if the points API
# is in the same Compose stack.

# STAFF_POINTS_API_URL=http://192.168.1.146:8788
# STAFF_POINTS_API_TOKEN=                           # sent as a Bearer token when set


# ─── Bank API ────────────────────────────────────────────────────────────────────────────────────
# POST /transfer {guildId, channelId, userId, amount} starts a transfer through the bank bot. No
# authentication — keep the port closed to the internet.

# BANK_TOKEN=                                       # the bank bot's own token
# BANK_API_HOST=0.0.0.0
# BANK_API_PORT=8790


# ─── Music bots ──────────────────────────────────────────────────────────────────────────────────
# /music create stores each music bot's token encrypted with this key (AES-256-GCM). Required for
# music bots; keep it safe and never change it — tokens encrypted with an old key can't be read.
#   openssl rand -hex 32

# MUSIC_TOKEN_KEY=
# YTDLP_PATH=/usr/local/bin/yt-dlp                  # the Docker image installs it; found on PATH otherwise


# ─── Minecraft bot ───────────────────────────────────────────────────────────────────────────────
# `/bot create` → Minecraft sends the token to the Minecraft API (the robtic-minecraft project),
# which saves it encrypted and keeps the bot running. Both must be set for the Minecraft option.

# The API runs in its own Compose project; from these containers the host is host.docker.internal.
# MINECRAFT_API_URL=http://host.docker.internal:3002
# Same value as MINECRAFT_BOT_SECRET in the Minecraft API's .env (openssl rand -hex 32).
# MINECRAFT_BOT_SECRET=


# ─── Internal APIs, Redis & workers ─────────────────────────────────────────────────────────────
# docker-compose.yml sets REDIS_URL and INVITES_API_URL to the internal service names. Locally,
# leave them unset to keep the old in-process behavior (no Redis needed).
#   openssl rand -hex 32

INTERNAL_API_TOKEN=
# REDIS_URL=redis://robtic-redis:6379
# INVITES_API_URL=http://robtic-invites-api:3005
# WORKER_CONCURRENCY=10                             # jobs per worker process (invites run 1 at a time regardless)
# DISCORD_OUTBOX_CONCURRENCY=5                      # Discord posts the Gateway sends in parallel
# GATEWAY_ROLE=primary                              # set by docker-compose.yml: primary | standby (failover)
# ACTIVITY_FLUSH_MS=30000                           # how often buffered message counts reach MongoDB (min 5000)
# EXTERNAL_API_CONCURRENCY=5                        # staff-API calls per worker in parallel
