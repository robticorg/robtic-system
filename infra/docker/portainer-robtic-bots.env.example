# Portainer stack `robtic-bots` — environment variables (names only; never commit values).
# Enter these under Stacks → robtic-bots → Environment variables. The manifest is
# infra/docker/compose/portainer-robtic-bots.yml; each line says which app variable it becomes.
# Required ones make the deploy fail when missing. An optional one left blank or left out gets the
# default shown.


# ─── Shared ──────────────────────────────────────────────────────────────────────────────────────

# Required. MongoDB on the database VM, e.g. mongodb://robtic:<pw>@192.168.1.120:27017/robtic?authSource=admin
# → MONGODB_URI (robtic-system, workers, invites API,
# Minecraft API, and robtic-staff unless STAFF_MONGODB_URI is set).
ROBTIC_MONGODB_URI=

# Required. The central Redis on the database VM, e.g. redis://:<pw>@192.168.1.120:6379/0 → REDIS_URL (robtic-system, standby, workers, invites
# API). Use a database index no other application uses, e.g. redis://<service>:6379/<n>. The Redis
# must not evict keys (maxmemory-policy noeviction) — BullMQ queues and the Gateway lock live here.
ROBTIC_REDIS_URL=

# Optional. Discord user id with the owner bypass → BOT_OWNER_ID (robtic-system, Minecraft API,
# robtic-staff).
ROBTIC_BOT_OWNER_ID=


# ─── robtic-system (Private System) ──────────────────────────────────────────────────────────────

# Required. Main Robtic bot token → MainBotToken (robtic-system, standby; Minecraft API for REST).
ROBTIC_SYSTEM_DISCORD_TOKEN=
# Required. Shared by the Gateway and the Invites API → INTERNAL_API_TOKEN.
ROBTIC_INTERNAL_API_TOKEN=
# Optional. Bank self-bot token → BANK_TOKEN. Without it the bank API answers 503.
ROBTIC_BANK_TOKEN=
# Optional. Encrypts saved music-bot tokens → MUSIC_TOKEN_KEY. Must stay the value already in use.
ROBTIC_MUSIC_TOKEN_KEY=
# Optional. Image tag; defaults to `production`. Set to sha-<commit> to roll back.
ROBTIC_SYSTEM_IMAGE_TAG=


# ─── robtic-minecraft-api ────────────────────────────────────────────────────────────────────────

# Optional. Authenticates /api/bot (the main bot's /bot create) → MINECRAFT_BOT_SECRET.
MINECRAFT_BOT_SECRET=
# Optional. 64 hex characters, encrypts the stored Minecraft bot token → BOT_TOKEN_KEY. Keep stable.
MINECRAFT_BOT_TOKEN_KEY=
# Optional. Shown by /ip and /status → ROBTIC_WEBSITE_URL, ROBTIC_DISCORD_INVITE.
MINECRAFT_WEBSITE_URL=
MINECRAFT_DISCORD_INVITE=
# Optional. Advertised in /api/docs → MINECRAFT_API_PUBLIC_URL (default https://minecraft.api.robtic.org).
MINECRAFT_API_PUBLIC_URL=
# Optional. Image tag; defaults to `production`.
MINECRAFT_API_IMAGE_TAG=


# ─── robtic-staff ────────────────────────────────────────────────────────────────────────────────

# Required. → DISCORD_TOKEN, DISCORD_APP_ID.
STAFF_DISCORD_TOKEN=
STAFF_DISCORD_APP_ID=
# Optional. → DISCORD_GUILD_ID, DISCORD_DEV_GUILD_ID (dev guild set = commands register there only).
STAFF_DISCORD_GUILD_ID=
STAFF_DISCORD_DEV_GUILD_ID=
# Optional. Only if staff uses a different MongoDB than ROBTIC_MONGODB_URI → MONGODB_URI.
STAFF_MONGODB_URI=
# Optional, with defaults: MONGODB_DB (robtic_staff), STAFF_TIMEZONE (UTC), LOG_LEVEL (info),
# PREFIX (!), FAST_ACCESS_PREFIX ($), MODMAIL_CASE_PREFIX (RPT-). Copy the old .env's values.
STAFF_MONGODB_DB=
STAFF_TIMEZONE=
STAFF_LOG_LEVEL=
STAFF_PREFIX=
STAFF_FAST_ACCESS_PREFIX=
STAFF_MODMAIL_CASE_PREFIX=
# Optional. Bearer token on the points API → INTERNAL_API_TOKEN (robtic-staff) and
# STAFF_POINTS_API_TOKEN (robtic-system, workers). One value, both sides.
STAFF_INTERNAL_API_TOKEN=
# Optional. Bank API for gift credits → AUTOCLAIM_API_URL (default http://robtic-system:8790).
STAFF_AUTOCLAIM_API_URL=
# Optional. → AUTOCLAIM_API_TOKEN, GIFT_LINK_SECRET.
STAFF_AUTOCLAIM_API_TOKEN=
STAFF_GIFT_LINK_SECRET=
# Optional. Image tag; defaults to `production`.
STAFF_IMAGE_TAG=


# ─── robtic-guard ────────────────────────────────────────────────────────────────────────────────

# Required. → TOKEN, MONGODB_URI (database `scamguard`).
GUARD_DISCORD_TOKEN=
GUARD_MONGODB_URI=
# Optional, defaults are the production values: GUARD_RISK_DELETE_THRESHOLD (85),
# GUARD_RISK_WARN_THRESHOLD (60), GUARD_RISK_LOG_THRESHOLD (30), GUARD_MAX_IMAGE_BYTES (8388608),
# GUARD_IMAGE_FETCH_TIMEOUT_MS (8000), GUARD_OCR_TIMEOUT_MS (10000), GUARD_OCR_LANG (eng),
# GUARD_HASH_CACHE_TTL_MS (300000), GUARD_FUZZY_HASH_MAX_DISTANCE (8),
# GUARD_DETECTION_MAX_CONCURRENCY (4), GUARD_API_ENABLED (0).
# Optional. Image tag; defaults to `production`.
GUARD_IMAGE_TAG=
