{
  "name": "robtic-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "bun --preload ./libs/shared/src/preload.ts --watch apps/bot/src/index.ts",
    "build": "bun build ./apps/bot/src/index.ts --outfile ./dist/index.js --target bun",
    "typecheck": "tsc --noEmit",
    "register:commands": "bun --preload ./libs/shared/src/preload.ts apps/bot/src/register-commands.ts",
    "test:top": "bun --preload ./libs/shared/src/preload.ts scripts/top-check.ts",
    "test:workspaces": "bun --preload ./libs/shared/src/preload.ts scripts/workspace-check.ts",
    "test:rewards": "bun --preload ./libs/shared/src/preload.ts scripts/reward-checks.ts",
    "test:invites": "bun --preload ./libs/shared/src/preload.ts scripts/invites-check.ts",
    "test:partner": "bun --preload ./libs/shared/src/preload.ts scripts/partner-check.ts",
    "test:boost": "bun --preload ./libs/shared/src/preload.ts scripts/boost-check.ts",
    "test:music": "bun --preload ./libs/shared/src/preload.ts scripts/music-check.ts",
    "test:roles": "bun --preload ./libs/shared/src/preload.ts scripts/roles-check.ts",
    "test:prefix": "bun --preload ./libs/shared/src/preload.ts scripts/prefix-check.ts",
    "test:moderation": "bun --preload ./libs/shared/src/preload.ts scripts/moderation-guard-check.ts",
    "test:robs": "bun --preload ./libs/shared/src/preload.ts scripts/robs-check.ts",
    "test:placeholders": "bash scripts/placeholder-docs-check.sh",
    "test:auth": "bun --preload ./libs/shared/src/preload.ts scripts/auth-check.ts",
    "test:auth:wiring": "bun --preload ./libs/shared/src/preload.ts scripts/auth-wiring-check.ts",
    "test:help": "bun --preload ./libs/shared/src/preload.ts scripts/help-check.ts",
    "db:drop-removed-features": "bun --preload ./libs/shared/src/preload.ts scripts/drop-removed-features.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "docker:build": "bash infra/docker/scripts/build.sh",
    "docker:local": "docker compose -f infra/docker/compose/docker-compose.local.yml",
    "docker:prod": "docker compose -f infra/docker/compose/docker-compose.yml"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yt-search": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.9",
    "@node-rs/argon2": "^2.1.0",
    "chalk": "^5.6.2",
    "discord.js": "^14.26.4",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "latest",
    "mongoose": "^9.7.2",
    "node-cron": "^4.5.0",
    "opusscript": "^0.1.0",
    "tesseract.js": "^7.0.0",
    "yt-search": "^2.13.1"
  }
}
